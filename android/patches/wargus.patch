+-- WarDroid: an on-screen keyboard, so a phone without its own keyboard can
+-- name a save or type a nickname. The multiplayer menu uses it too.
+local keyArt = {}
+local function KeyArt(file, w, h)
+  local key = file .. "@" .. tostring(w) .. "x" .. tostring(h)
+  if (keyArt[key] == nil) then
+    local g = CGraphic:ForceNew(file)
+    g:Load()
+    g:Resize(w, h)
+    keyArt[key] = g
+  end
+  return keyArt[key]
+end
+
+-- Make a text field taller. Its bar image is always drawn at the image's own
+-- height, so the field gets a stretched copy of the bar.
+function SetTextFieldHeight(field, width, height)
+  local widgets = "ui/orc/widgets/"
+  if (GetPlayerData(GetThisPlayer(), "RaceName") == "human") then
+    widgets = "ui/human/widgets/"
+  end
+  field:setItemImage(KeyArt(widgets .. "pulldown-bar-normal.png", width, height))
+  field:setSize(width, height)
+end
+
+local keyRows = {
+  {"1", "2", "3", "4", "5", "6", "7", "8", "9", "0"},
+  {"q", "w", "e", "r", "t", "y", "u", "i", "o", "p"},
+  {"a", "s", "d", "f", "g", "h", "j", "k", "l", "Del"},
+  {"z", "x", "c", "v", "b", "n", "m", "_"},
+}
+-- Key sizes at the given scale: 1 is the original size, ScreenKeyboardBig
+-- is used wherever the screen has room, for bigger fingers.
+ScreenKeyboardBig = 1.25
+local function KeyMetrics(scale)
+  local function s(v) return math.floor(v * scale + 0.5) end
+  return s(38), s(34), s(4), s(16) -- key width, key height, gap, margin
+end
+
+function ScreenKeyboardWidth(scale)
+  local keyWidth, keyHeight, keyGap, keyMargin = KeyMetrics(scale)
+  return 10 * keyWidth + 9 * keyGap + 2 * keyMargin
+end
+
+function ScreenKeyboardHeight(scale)
+  local keyWidth, keyHeight, keyGap, keyMargin = KeyMetrics(scale)
+  return 4 * keyHeight + 3 * keyGap + 2 * keyMargin
+end
+
+-- The biggest scale whose keyboard fits in the given width, or nil.
+function ScreenKeyboardScale(room)
+  if (room >= ScreenKeyboardWidth(ScreenKeyboardBig)) then
+    return ScreenKeyboardBig
+  elseif (room >= ScreenKeyboardWidth(1)) then
+    return 1
+  end
+  return nil
+end
+
+local keyboardGap = 8
+
+-- Add the keyboard at the given scale to menu at (x, y) on a panel of the
+-- given height, typing into the text field that target() returns. The first
+-- key pressed replaces the field's default text while isFresh() says so;
+-- setFresh(false) ends that.
+function AddScreenKeyboard(menu, scale, x, y, height, target, isFresh, setFresh)
+  local keyWidth, keyHeight, keyGap = KeyMetrics(scale)
+  local keyboardWidth = ScreenKeyboardWidth(scale)
+  menu:add(ImageWidget(KeyArt(panel(3), keyboardWidth, height)), x, y)
+
+  local widgets = "ui/orc/widgets/"
+  if (GetPlayerData(GetThisPlayer(), "RaceName") == "human") then
+    widgets = "ui/human/widgets/"
+  end
+  local top = y + (height - (4 * keyHeight + 3 * keyGap)) / 2
+  for row, keys in ipairs(keyRows) do
+    local rowWidth = table.getn(keys) * keyWidth + (table.getn(keys) - 1) * keyGap
+    local left = x + (keyboardWidth - rowWidth) / 2
+    local ky = top + (row - 1) * (keyHeight + keyGap)
+    for i, key in ipairs(keys) do
+      local b = menu:addImageButton(key, "", left + (i - 1) * (keyWidth + keyGap), ky,
+        function()
+          local t = target()
+          local text = t:getText()
+          if (isFresh()) then
+            text = ""
+            setFresh(false)
+          end
+          if (key == "Del") then
+            text = string.sub(text, 1, -2)
+          else
+            text = text .. key
+          end
+          t:setText(text)
+          t:setCaretPosition(string.len(text))
+          t:requestFocus()
+        end)
+      b:setNormalImage(KeyArt(widgets .. "button-small-normal.png", keyWidth, keyHeight))
+      b:setPressedImage(KeyArt(widgets .. "button-small-pressed.png", keyWidth, keyHeight))
+      b:setDisabledImage(KeyArt(widgets .. "button-small-grayed.png", keyWidth, keyHeight))
+      if (key == "Del") then
+        b:setFont(Fonts["game"])
+      else
+        b:setFont(Fonts["large"])
+      end
+      b:setSize(keyWidth, keyHeight)
+    end
+  end
+end
