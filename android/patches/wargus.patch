+-- WarDroid: the nickname. A player with no name of their own yet (none
+-- saved, or the plain default) gets WarDroid and three random digits, saved
+-- straight away so it stays the same next time.
+function MultiPlayerNickname()
+  local name = wc2.preferences.PlayerName
+  if (name == nil or name == "" or name == "WarDroid") then
+    math.randomseed(os.time() + math.floor(os.clock() * 1000))
+    name = string.format("WarDroid%03d", math.random(0, 999))
