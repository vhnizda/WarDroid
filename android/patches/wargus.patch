+-- Like menu:addLabel, centred on x unless center is false.
+function AddOutlinedLabel(menu, text, x, y, font, center)
+  for dx = -1, 1 do
+    for dy = -1, 1 do
+      if (dx ~= 0 or dy ~= 0) then
+        menu:addLabel("~outline~" .. text, x + dx, y + dy, font, center)
+      end
+    end
+  end
+  return menu:addLabel(text, x, y, font, center)
+end
+
+function WriteOutlinedText(menu, text, x, y, font)
+  return AddOutlinedLabel(menu, text, x, y, font or Fonts["game"], false)
