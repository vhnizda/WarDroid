+end
+
+-- Save the name typed into the nick field when the player moves on to a
+-- game. An empty field keeps the saved name.
+function SaveMultiPlayerNickname(nick)
+  local name = nick:getText()
+  if (name == "") then
+    nick:setText(GetLocalPlayerName())
+    return
+  end
+  if (name ~= GetLocalPlayerName() or name ~= wc2.preferences.PlayerName) then
+    SetLocalPlayerName(name)
+    wc2.preferences.PlayerName = name
+    SavePreferences()
+  end
+end
+
+-- Add a labelled text field in the large font, filling the form's width
+-- from x. Returns the field and the y below it.
+function AddMultiPlayerField(menu, label, text, x, y)
+  -- The large font at 130%, in a box tall enough to hold it with room
+  -- above and below.
+  local font = LargeFont130()
+  local labelWidth = math.max(font:Width(_("Nickname :")), font:Width(_("Password :"))) + 10
