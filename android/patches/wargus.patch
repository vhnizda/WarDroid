+function AddMultiPlayerField(menu, label, text, x, y)
+  local font = Fonts["large"]
+  local labelWidth = math.max(font:Width(_("Nickname :")), font:Width(_("Password :"))) + 10
+  -- The bar is 18 pixels tall; 20% taller keeps the large text inside it.
+  local height = 22
+  WriteOutlinedText(menu, label, x, y + (height - font:Height()) / 2, font)
+  local field = menu:addTextInputField(text, x + labelWidth, y, mpFormWidth - labelWidth)
+  field:setFont(font)
+  SetTextFieldHeight(field, mpFormWidth - labelWidth, height)
+  return field, y + height + 6
+end
