+-- WarDroid: when the screen is wide enough, the multiplayer form moves to the
+-- left and the on-screen keyboard sits to its right, so a phone can type a
+-- nickname or password. The spare width is split evenly around the two.
+local mpFormWidth = 280
+local mpMinGap = 10
+
+-- The keyboard's scale, or nil when there's no room for it.
+local function MultiPlayerKeyboardScale()
+  return ScreenKeyboardScale(Video.Width - mpFormWidth - 3 * mpMinGap)
+end
+
+-- The width left over around the form and the keyboard.
+local function MultiPlayerSpare()
+  return Video.Width - mpFormWidth - ScreenKeyboardWidth(MultiPlayerKeyboardScale())
+end
+
+-- The left edge of the form: label, fields and buttons.
+function MultiPlayerFormX()
+  if (MultiPlayerKeyboardScale() ~= nil) then
+    return math.floor(MultiPlayerSpare() / 3)
+  end
+  return (Video.Width - 640) / 2 + 208
+end
+
+-- The keyboard's left edge, or nil when there's no keyboard.
+local function MultiPlayerKeyboardX()
+  if (MultiPlayerKeyboardScale() == nil) then
+    return nil
+  end
