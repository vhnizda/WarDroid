+-- The large font scaled to glyphs of the given size in pixels (17 is
+-- normal), for touch friendly menus.
+local scaledLargeFonts = {}
+function ScaledLargeFont(size, name)
+  if (scaledLargeFonts[size] == nil) then
+    -- large.png is a grid of 15 x 14 glyphs of 17 x 17 pixels.
+    local g = CGraphic:ForceNew("ui/fonts/large.png", 17, 17)
+    g:Load()
+    g:Resize(15 * size, 14 * size)
+    scaledLargeFonts[size] = CFont:New(name or ("large-" .. size), g)
+  end
+  return scaledLargeFonts[size]
+end
+
+-- The large font at 130%.
+function LargeFont130()
+  return ScaledLargeFont(22, "large-130")
+end
+
+-- The large buttons at 130%: 291 x 36 instead of 224 x 28.
+BigButtonWidth = 291
+BigButtonHeight = 36
+local bigButtonArt = {}
+local function BigButtonImage(file, width, height)
+  local key = file .. width .. "x" .. height
+  if (bigButtonArt[key] == nil) then
+    local g = CGraphic:ForceNew(file)
+    g:Load()
+    g:Resize(width, height)
+    bigButtonArt[key] = g
+  end
+  return bigButtonArt[key]
+end
+
+-- Touch friendly menus, laid out like the main screen: buttons in the
+-- space below the Warcraft logo and above the version line, in up to two
+-- columns of up to four. The space is a grid of four rows with equal gaps;
+-- buttons fill the rest, and their text is half their height.
+function BigMenuGrid()
+  local grid = {}
+  grid.top = math.floor(Video.Height * 0.33)
+  grid.bottom = Video.Height - 24
+  grid.gapY = 14
+  grid.gapX = math.floor(Video.Width / 16)
+  grid.width = math.floor((Video.Width - 3 * grid.gapX) / 2)
+  grid.height = math.floor((grid.bottom - grid.top - 5 * grid.gapY) / 4)
+  grid.font = ScaledLargeFont(math.floor(grid.height / 2))
+  -- The left edge of column 0 or 1, or of a single centred column.
+  function grid.x(column)
+    if (column == nil) then
+      return math.floor((Video.Width - grid.width) / 2)
+    end
+    return grid.gapX + column * (grid.width + grid.gapX)
+  end
+  -- The top of row 0 to 3, for a block of the given number of rows
+  -- centred in the space.
+  function grid.y(row, rows)
+    local block = rows * grid.height + (rows - 1) * grid.gapY
+    local top = grid.top + math.floor((grid.bottom - grid.top - block) / 2)
+    return top + row * (grid.height + grid.gapY)
+  end
+  return grid
+end
+
+-- Add a big button at a column (nil for centred) and row of the grid.
+function AddBigGridButton(menu, grid, caption, hotkey, column, row, rows, callback)
+  local b = menu:addBigButton(caption, hotkey, grid.x(column), grid.y(row, rows),
+                              callback, grid.width, grid.height)
+  b:setFont(grid.font)
+  return b
+end
+
+-- Add buttons, each {caption, hotkey, callback}. Up to four go in one
+-- centred column; more fill a left column first, then a right one. Buttons
+-- side by side share the same row.
+function AddBigButtonGrid(menu, buttons)
+  local grid = BigMenuGrid()
+  local n = table.getn(buttons)
+  local columns = 1
+  if (n > 4) then
+    columns = 2
+  end
+  local rows = math.ceil(n / columns)
+  if (rows > 4) then
+    -- More than eight buttons: make them shorter so they still fit.
+    grid.height = math.floor((grid.bottom - grid.top - (rows + 1) * grid.gapY) / rows)
+    grid.font = ScaledLargeFont(math.max(17, math.floor(grid.height / 2)))
+  end
+  for i, b in ipairs(buttons) do
+    local column = nil
+    if (columns == 2) then
+      column = math.floor((i - 1) / rows)
+    end
+    AddBigGridButton(menu, grid, b[1], b[2], column, (i - 1) - math.floor((i - 1) / rows) * rows, rows, b[3])
+  end
+  return grid
+end
+
+-- Lists to choose from, made bigger for touch: rows this many pixels high,
+-- in the large font at the same size.
+BigListRowHeight = 28
+
+-- Give a list box big rows. The rows are as wide as the box when the font
+-- is set, so when the list will scroll, narrow them by the scroll bar's
+-- width first; otherwise they don't fit beside the bar and a horizontal
+-- bar appears too.
+function SetBigListFont(list, w, h, scrolls)
+  if (scrolls) then
+    list:setSize(w - list:getScrollbarWidth(), h)
+  end
+  list:setFont(ScaledLargeFont(BigListRowHeight))
+  list:setSize(w, h)
+end
+
+-- An image stretched to w x h, kept so each size is made once. Its own copy,
+-- so stretching it leaves the image elsewhere at its normal size.
+local stretchedImages = {}
+function StretchedImage(file, w, h)
+  local key = file .. "@" .. w .. "x" .. h
+  if (stretchedImages[key] == nil) then
+    local g = CGraphic:ForceNew(file)
+    g:Load()
+    g:Resize(w, h)
+    stretchedImages[key] = g
+  end
+  return stretchedImages[key]
+end
+
+-- A menu shown over the game, with its panel stretched to w x h and
+-- centred on the screen.
+function BigGameMenu(panelImage, w, h)
+  local menu = WarGameMenu(nil)
+  menu:setOpaque(false)
+  menu:add(ImageWidget(StretchedImage(panelImage, w, h)), 0, 0)
+  menu:resize(w, h)
+  return menu
+end
+
+-- A pop up for choosing from a list, made bigger for touch: the panel
+-- stretched to w x h and centred on the screen.
+function BigListPopup(panelImage, w, h)
+  local menu = WarMenu(nil, panelImage, {w, h})
+  menu:setDrawMenusUnder(true)
+  return menu
+end
+
+-- A big pop up's layout: its title at the top, the list below it, and a
+-- pair of buttons along the bottom. It shows up to 9 rows, fewer if the
+-- screen is too short for that.
+BigPopupWidth = 560
+BigPopupListY = 50
+local bigPopupChrome = BigPopupListY + 18 + 40 + 24 -- title, gap, buttons, margin
+function BigPopupRows()
+  return math.max(4, math.min(9, math.floor((Video.Height - 40 - bigPopupChrome) / BigListRowHeight)))
+end
+function BigPopupSize(rows)
+  return BigPopupWidth, bigPopupChrome + rows * BigListRowHeight
+end
+
+-- The OK and Cancel style pair of buttons along a big pop up's bottom.
+BigPopupButtonHeight = 40
+function AddBigPopupButtons(menu, w, h, left, right)
+  local gap = 24
+  local bw = math.floor((w - 3 * gap) / 2)
+  local y = h - gap - BigPopupButtonHeight
+  local a = menu:addBigButton(left[1], left[2], gap, y, left[3], bw, BigPopupButtonHeight)
+  local b = menu:addBigButton(right[1], right[2], 2 * gap + bw, y, right[3], bw, BigPopupButtonHeight)
+  return a, b
+end
+
+-- A menu's title, at the top right beside the Warcraft logo, as on the
+-- Multiplayer screen.
+function AddBigMenuTitle(menu, title)
+  local grid = BigMenuGrid()
+  return menu:addLabel(title, grid.x(1) + grid.width / 2, math.floor(Video.Height * 0.09), LargeFont130())
+end
+
