+-- WarDroid: when the screen is wide enough, the multiplayer form moves to the
+-- left and the on-screen keyboard sits to its right, so a phone can type a
+-- nickname or password. The spare width is split evenly around the two.
+local mpFormWidth = 330
+local mpMinGap = 10
+-- The form's buttons are big, for touch, with the large font at 130%.
+local mpButtonHeight = 44
+
+-- The keyboard's scale, or nil when there's no room for it.
+local function MultiPlayerKeyboardScale()
+  return ScreenKeyboardScale(Video.Width - mpFormWidth - 3 * mpMinGap)
+end
+
+-- The width left over around the form and the keyboard.
+local function MultiPlayerSpare()
+  return Video.Width - mpFormWidth - ScreenKeyboardWidth(MultiPlayerKeyboardScale())
+end
+
+-- The left edge of the form: label, fields and buttons.
+function MultiPlayerFormX()
+  if (MultiPlayerKeyboardScale() ~= nil) then
+    return math.floor(MultiPlayerSpare() / 3)
+  end
+  return (Video.Width - 640) / 2 + 208
+end
+
+-- The keyboard's left edge, or nil when there's no keyboard.
+local function MultiPlayerKeyboardX()
+  if (MultiPlayerKeyboardScale() == nil) then
+    return nil
+  end
+  return math.floor(MultiPlayerSpare() / 3) * 2 + mpFormWidth
+end
+
+-- A big button in the form, as wide as the form unless a width is given.
+function AddMultiPlayerButton(menu, caption, hotkey, y, callback, width)
+  return menu:addBigButton(caption, hotkey, MultiPlayerFormX(), y, callback,
+                           width or mpFormWidth, mpButtonHeight)
+end
+
+-- The tops of count form buttons, spread evenly from top down to the
+-- version line at the bottom of the screen.
+function MultiPlayerButtonYs(top, count)
+  local bottom = Video.Height - 24
+  local gap = math.floor((bottom - top - count * mpButtonHeight) / (count + 1))
+  local ys = {}
+  for i = 1, count do
+    ys[i] = top + gap * i + mpButtonHeight * (i - 1)
+  end
+  return ys
+end
+
+-- The large font at 130%, for the screen's title.
+local function TitleFont()
+  return LargeFont130()
+end
+
+-- Add the screen's title: at the top right over the keyboard, or where
+-- Wargus had it when there's no keyboard.
+function AddMultiPlayerTitle(menu, offx, offy)
+  local title = _("~<Multiplayer Network Game~>")
+  local x = MultiPlayerKeyboardX()
+  if (x == nil) then
+    menu:addLabel(title, offx + 640/2 + 12, offy + 192, TitleFont())
+  else
+    local width = ScreenKeyboardWidth(MultiPlayerKeyboardScale())
+    menu:addLabel(title, x + width / 2, offy + 110, TitleFont())
+  end
+end
+
+-- Add the keyboard at height y, typing into whichever of fields was tapped
+-- last (the first one to begin with). The first key typed into a field
+-- replaces its text, like the save menu.
+function AddMultiPlayerKeyboard(menu, y, fields)
+  local scale = MultiPlayerKeyboardScale()
+  if (scale == nil) then
+    return
+  end
+  local current = 1
+  local fresh = {}
+  for i, f in ipairs(fields) do
+    fresh[i] = true
+    local index = i
+    f:setMouseCallback(function(evt)
+      if (evt == "mousePress") then
+        current = index
+      end
+    end)
+  end
+  AddScreenKeyboard(menu, scale, MultiPlayerKeyboardX(), y, ScreenKeyboardHeight(scale),
+    function() return fields[current] end,
+    function() return fresh[current] end,
+    function(v) fresh[current] = v end)
+end
+
+-- Text drawn with a black outline, so it stands out on the light background:
+-- black copies one pixel off in each direction, then the text on top.
+DefineFontColor("outline",
