+/*
+** LAN search, which works where routers drop the multicast that mDNS needs.
+** While the host's game menu is open it answers probes on the port after the
+** game port, and joiners send a probe to every address in their subnets.
+*/
+static const std::string LanSearchProbe = "WARDROID?";
+static const std::string LanSearchAnswer = "WARDROID!";
+static const int LanSearchPort = CNetworkParameter::defaultPort + 1;
+
+static void AnswerLanSearch()
+{
+	static Socket beacon = static_cast<Socket>(-1);
+	static bool openFailed = false;
+
+	if (beacon == static_cast<Socket>(-1)) {
+		if (openFailed) {
+			return;
+		}
+		beacon = NetOpenUDP(INADDR_ANY, LanSearchPort);
+		if (beacon == static_cast<Socket>(-1)) {
+			openFailed = true;
+			return;
+		}
+		NetSetNonBlocking(beacon);
+	}
+
+	const std::string probe = LanSearchProbe + GameName;
+	const std::string answer = LanSearchAnswer + GameName + " " + std::to_string(CNetworkParameter::Instance.localPort);
+	char buf[64];
+	while (NetSocketReady(beacon, 0) > 0) {
+		unsigned long host;
+		int port;
+		const int len = NetRecvUDP(beacon, buf, sizeof(buf), &host, &port);
+		if (len < 0) {
+			break;
+		}
+		if (std::string(buf, len) == probe) {
+			NetSendUDP(beacon, host, port, answer.data(), answer.size());
+		}
+	}
+}
+
