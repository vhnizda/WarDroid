+
+#ifdef __ANDROID__
+static constexpr bool TouchControlsEnabled = true;
+#else
+static constexpr bool TouchControlsEnabled = false;
+#endif
+
+/// Joystick shield radius and knob (shield boss) radius, in screen pixels.
+static constexpr int JoystickRadius = 40;
+static constexpr int KnobRadius = 14;
+/// Width of the iron rim around the shield.
+static constexpr int RimWidth = 4;
+/// Distance between the shield's planks.
+static constexpr int PlankWidth = 13;
+/// Knob travel below which the joystick doesn't scroll.
+static constexpr int JoystickDeadZone = 8;
+/// Map scrolling speed while the joystick is pushed, in pixels per second.
+static constexpr double JoystickScrollSpeed = 480;
+/// Size of the deselect button, in screen pixels.
+static constexpr int DeselectWidth = 44;
+static constexpr int DeselectHeight = 40;
+/// The game's blue button, cut down to a box for the deselect button.
+static constexpr const char *DeselectButtonFile = "ui/human/widgets/button-small-normal.png";
+static std::shared_ptr<CGraphic> DeselectButton;
+/// Gap between the controls and the edge of the map area.
+static constexpr int ControlMargin = 8;
+
+static bool JoystickHeld = false;
+static PixelDiff KnobOffset(0, 0);
+static Uint32 LastScrollTicks = 0;
+static double ScrollRemainderX = 0;
+static double ScrollRemainderY = 0;
+
+/*----------------------------------------------------------------------------
+--  Functions
+----------------------------------------------------------------------------*/
+
+static PixelPos JoystickCenter()
+{
+	return PixelPos(UI.MapArea.X + ControlMargin + JoystickRadius,
+	                UI.MapArea.EndY - ControlMargin - JoystickRadius);
+}
+
+static PixelPos DeselectTopLeft()
+{
+	return PixelPos(UI.MapArea.EndX - ControlMargin - DeselectWidth,
+	                UI.MapArea.EndY - ControlMargin - DeselectHeight);
+}
+
+static bool ControlsShown()
+{
+	return TouchControlsEnabled && GameRunning && !GamePaused;
+}
+
+static bool DeselectShown()
+{
+	return ControlsShown() && !Selected.empty();
+}
+
+static bool IsOnJoystick(const PixelPos &screenPos)
+{
+	const PixelDiff d = screenPos - JoystickCenter();
+	return d.x * d.x + d.y * d.y <= JoystickRadius * JoystickRadius;
+}
+
+static bool IsOnDeselect(const PixelPos &screenPos)
+{
+	const PixelPos topLeft = DeselectTopLeft();
+	return screenPos.x >= topLeft.x && screenPos.x < topLeft.x + DeselectWidth
+	       && screenPos.y >= topLeft.y && screenPos.y < topLeft.y + DeselectHeight;
+}
+
+/// Puts the knob under the finger, kept within the base.
+static void MoveKnob(const PixelPos &screenPos)
+{
+	PixelDiff d = screenPos - JoystickCenter();
+	const double length = std::sqrt(double(d.x * d.x + d.y * d.y));
+	if (length > JoystickRadius) {
+		d.x = int(d.x * JoystickRadius / length);
+		d.y = int(d.y * JoystickRadius / length);
+	}
+	KnobOffset = d;
+}
+
+static Uint32 Rgb(Uint8 r, Uint8 g, Uint8 b)
+{
+	return Video.MapRGB(TheScreen->format, r, g, b);
+}
+
+/// A round wooden shield of vertical planks with an iron rim and rivets.
+static void DrawShield(const PixelPos &center)
+{
+	Video.FillCircleClip(Rgb(58, 58, 64), center, JoystickRadius);
+	Video.FillCircleClip(Rgb(132, 84, 40), center, JoystickRadius - RimWidth);
+
+	const int wood = JoystickRadius - RimWidth;
+	for (int dx = -wood + PlankWidth; dx < wood; dx += PlankWidth) {
+		const int half = static_cast<int>(std::sqrt(double(wood * wood - dx * dx)));
+		Video.DrawVLineClip(Rgb(84, 50, 22), center.x + dx, center.y - half, 2 * half);
+		Video.DrawVLineClip(Rgb(162, 110, 58), center.x + dx + 1, center.y - half, 2 * half);
+	}
+	Video.DrawCircleClip(Rgb(124, 124, 132), center.x, center.y, JoystickRadius - 1);
+	Video.DrawCircleClip(Rgb(32, 32, 36), center.x, center.y, JoystickRadius - RimWidth);
+
+	for (int i = 0; i < 8; ++i) {
+		const double angle = i * M_PI / 4 + M_PI / 8;
+		const int r = JoystickRadius - RimWidth / 2;
+		const PixelPos rivet(center.x + static_cast<int>(std::lround(r * std::cos(angle))),
+		                     center.y + static_cast<int>(std::lround(r * std::sin(angle))));
+		Video.FillCircleClip(Rgb(196, 192, 176), rivet, 1);
+	}
+
+	// Arrow heads pointing up, right, down and left, so the boss reads as a
+	// knob that can be pushed.
+	const int tip = wood - 3;
+	const int base = KnobRadius + 4;
+	const int spread = 6;
+	const PixelDiff directions[] = {{0, -1}, {1, 0}, {0, 1}, {-1, 0}};
+	for (const PixelDiff &d : directions) {
+		const PixelDiff side(-d.y, d.x);
+		const PixelPos a = center + d * tip;
+		const PixelPos b = center + d * base + side * spread;
+		const PixelPos c = center + d * base - side * spread;
+		for (const auto &[color, shift] : {std::pair(Rgb(60, 34, 12), PixelDiff(1, 1)),
+		                                    std::pair(Rgb(244, 214, 150), PixelDiff(0, 0))}) {
+			Video.DrawLineClip(color, a + shift, b + shift);
+			Video.DrawLineClip(color, b + shift, c + shift);
+			Video.DrawLineClip(color, c + shift, a + shift);
+		}
+	}
+}
+
+/// The shield's iron boss, which is the knob that moves.
+static void DrawBoss(const PixelPos &center)
+{
+	Video.FillCircleClip(Rgb(24, 24, 28), center + PixelDiff(1, 2), KnobRadius);
+	Video.FillCircleClip(Rgb(112, 112, 120), center, KnobRadius);
+	Video.FillCircleClip(Rgb(150, 150, 158), center - PixelDiff(2, 2), KnobRadius - 5);
+	Video.FillCircleClip(Rgb(210, 210, 216), center - PixelDiff(5, 5), 3);
+	Video.DrawCircleClip(Rgb(40, 40, 46), center.x, center.y, KnobRadius);
+}
+
+/// The game's blue button cut into a box, with a gold X on it.
+static void DrawDeselectButton(const PixelPos &topLeft)
+{
+	if (!DeselectButton) {
+		DeselectButton = CGraphic::ForceNew(DeselectButtonFile);
+		DeselectButton->Load();
+		// Scale to the box's height, then use both ends so it keeps its bevel.
+		DeselectButton->Resize(DeselectButton->Width * DeselectHeight / DeselectButton->Height,
+		                       DeselectHeight);
+	}
+	const int half = DeselectWidth / 2;
+	DeselectButton->DrawSubClip(0, 0, half, DeselectHeight, topLeft.x, topLeft.y);
+	DeselectButton->DrawSubClip(DeselectButton->Width - (DeselectWidth - half), 0,
+	                            DeselectWidth - half, DeselectHeight, topLeft.x + half, topLeft.y);
+
+	const int size = 18;
+	const PixelPos a(topLeft.x + (DeselectWidth - size) / 2, topLeft.y + (DeselectHeight - size) / 2);
+	const PixelPos b = a + PixelDiff(size, size);
+	const Uint32 shadow = Rgb(40, 24, 0);
+	const Uint32 gold = Rgb(252, 204, 52);
+	const Uint32 shine = Rgb(255, 240, 150);
+	for (int i = -1; i <= 1; ++i) {
+		Video.DrawLineClip(shadow, PixelPos(a.x + i + 1, a.y + 1), PixelPos(b.x + i + 1, b.y + 1));
+		Video.DrawLineClip(shadow, PixelPos(b.x + i + 1, a.y + 1), PixelPos(a.x + i + 1, b.y + 1));
+	}
+	for (int i = -1; i <= 1; ++i) {
+		const Uint32 color = i < 0 ? shine : gold;
+		Video.DrawLineClip(color, PixelPos(a.x + i, a.y), PixelPos(b.x + i, b.y));
+		Video.DrawLineClip(color, PixelPos(b.x + i, a.y), PixelPos(a.x + i, b.y));
+	}
+}
+
+/**
+**  Draw the joystick and, when units are selected, the deselect button.
+*/
+void DrawTouchControls()
+{
+	if (!ControlsShown()) {
+		return;
+	}
+	const PixelPos center = JoystickCenter();
+	DrawShield(center);
+	DrawBoss(center + KnobOffset);
+
+	if (DeselectShown()) {
+		DrawDeselectButton(DeselectTopLeft());
+	}
+}
+
+/**
+**  Handle a press on the controls.
+**
+**  @return  True if the press was on a control and must not reach the map.
+*/
+bool TouchControlsButtonDown(const PixelPos &screenPos)
+{
+	if (!ControlsShown()) {
+		return false;
+	}
+	// Holding the joystick still sends a long press, which mustn't start
+	// a selection box.
+	if (JoystickHeld) {
+		return true;
+	}
+	if (DeselectShown() && IsOnDeselect(screenPos)) {
+		UnSelectAll();
+		NetworkSendSelection(nullptr, 0);
+		SelectionChanged();
+		return true;
+	}
+	if (IsOnJoystick(screenPos)) {
+		JoystickHeld = true;
+		LastScrollTicks = SDL_GetTicks();
+		ScrollRemainderX = ScrollRemainderY = 0;
+		MoveKnob(screenPos);
+		return true;
+	}
+	return false;
+}
+
+/**
+**  Follow the finger while the joystick is held.
+**
+**  @return  True if the joystick is held and the move must not reach the map.
+*/
+bool TouchControlsMouseMove(const PixelPos &screenPos)
+{
+	if (!JoystickHeld) {
+		return false;
+	}
+	MoveKnob(screenPos);
+	return true;
+}
+
+/**
+**  Let go of the joystick.
+**
+**  @return  True if the joystick was held and the release must not reach the map.
+*/
+bool TouchControlsButtonUp()
+{
+	if (!JoystickHeld) {
+		return false;
+	}
+	JoystickHeld = false;
+	KnobOffset = PixelDiff(0, 0);
+	return true;
+}
+
+/**
+**  Scroll the map at an even speed in the direction the joystick points.
+**  Called once per displayed frame.
+*/
+void TouchControlsScroll()
+{
+	if (!JoystickHeld) {
+		return;
+	}
+	if (!ControlsShown()) {
+		TouchControlsButtonUp();
+		return;
+	}
+	const Uint32 now = SDL_GetTicks();
+	const double seconds = (now - LastScrollTicks) / 1000.0;
+	LastScrollTicks = now;
+
+	const double length = std::sqrt(double(KnobOffset.x * KnobOffset.x + KnobOffset.y * KnobOffset.y));
+	if (length < JoystickDeadZone) {
+		return;
+	}
+	ScrollRemainderX += KnobOffset.x / length * JoystickScrollSpeed * seconds;
+	ScrollRemainderY += KnobOffset.y / length * JoystickScrollSpeed * seconds;
+	const PixelDiff step(static_cast<int>(ScrollRemainderX), static_cast<int>(ScrollRemainderY));
+	ScrollRemainderX -= step.x;
+	ScrollRemainderY -= step.y;
+	if (step.x || step.y) {
+		CViewport *vp = UI.SelectedViewport;
+		vp->Set(vp->MapPos, vp->Offset + step);
+	}
+}
+
