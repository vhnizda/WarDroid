+/*----------------------------------------------------------------------------
+--  Variables
+----------------------------------------------------------------------------*/
+
+#ifdef __ANDROID__
+static constexpr bool TouchControlsEnabled = true;
+#else
+static constexpr bool TouchControlsEnabled = false;
+#endif
+
+/// Joystick shield radius and knob (shield boss) radius, in screen pixels.
+static constexpr int JoystickRadius = 80;
+static constexpr int KnobRadius = 28;
+/// Width of the iron rim around the shield.
+static constexpr int RimWidth = 8;
+/// Distance between the shield's planks.
+static constexpr int PlankWidth = 26;
+/// Knob travel below which the joystick doesn't scroll.
+static constexpr int JoystickDeadZone = 16;
+/// Opacity of the joystick, so the map shows through it.
+static constexpr Uint8 JoystickAlpha = 128;
+/// Map scrolling speed while the joystick is pushed, in pixels per second.
+static constexpr double JoystickScrollSpeed = 480;
+/// Size of the deselect and group buttons, in screen pixels. Big enough
+/// for a thumb.
+static constexpr int ButtonWidth = 58;
+static constexpr int ButtonHeight = 53;
+/// Gap between neighbouring buttons.
+static constexpr int ButtonGap = 5;
+/// The deselect button is 30% bigger than the group buttons, with a wider
+/// gap on each side so it's easy to hit without touching a group button.
+static constexpr int DeselectWidth = ButtonWidth * 13 / 10;
+static constexpr int DeselectHeight = ButtonHeight * 13 / 10;
+static constexpr int DeselectGap = 15;
+/// Number of group buttons, left of the deselect button.
+static constexpr int GroupButtons = 4;
+/// How long a group button is held to save the selection into it.
+static constexpr Uint32 GroupHoldMs = 600;
+
+/// The game's buttons, cut down to boxes: blue for the deselect button and
+/// groups in use, burgundy for empty groups.
+static constexpr const char *BlueButtonFile = "ui/human/widgets/button-small-normal.png";
+static constexpr const char *BlueButtonPressedFile = "ui/human/widgets/button-small-pressed.png";
+static constexpr const char *RedButtonFile = "ui/orc/widgets/button-small-normal.png";
+static constexpr const char *RedButtonPressedFile = "ui/orc/widgets/button-small-pressed.png";
+static std::map<std::string, std::shared_ptr<CGraphic>> ButtonGraphics;
+
+/// Group button being held, 1 to GroupButtons, or 0.
+static int PressedGroup = 0;
+static Uint32 PressedGroupTicks = 0;
+/// Whether the held group button has already saved the selection.
+static bool PressedGroupSaved = false;
+/// Gap between the controls and the edge of the map area.
+static constexpr int ControlMargin = 8;
+
+static bool JoystickHeld = false;
+static PixelDiff KnobOffset(0, 0);
+static Uint32 LastScrollTicks = 0;
+static double ScrollRemainderX = 0;
+static double ScrollRemainderY = 0;
+/// The joystick is held by a finger other than the pointer's, such as while
+/// the pointer's finger holds a building to place.
+static bool JoystickByFinger = false;
+static SDL_FingerID JoystickFingerId = 0;
+/// The pointer's finger pressed the joystick while another finger held it,
+/// so its release is ignored too.
+static bool PointerPressIgnored = false;
+/// The finger holding a building while the pointer's finger holds the joystick.
+static SDL_FingerID BuildingFingerId = 0;
+
+/*----------------------------------------------------------------------------
+--  Functions
+----------------------------------------------------------------------------*/
+
+static PixelPos JoystickCenter()
+{
+	return PixelPos(UI.MapArea.X + ControlMargin + JoystickRadius,
+	                UI.MapArea.EndY - ControlMargin - JoystickRadius);
+}
+
+static PixelPos DeselectTopLeft()
+{
+	return PixelPos(UI.MapArea.EndX - DeselectGap - DeselectWidth,
+	                UI.MapArea.EndY - ControlMargin - DeselectHeight);
+}
+
+/// Top left of a group button: 4 is nearest the deselect button.
+static PixelPos GroupTopLeft(int group)
+{
+	const int right = DeselectTopLeft().x - DeselectGap;
+	return PixelPos(right - ButtonWidth - (GroupButtons - group) * (ButtonWidth + ButtonGap),
+	                UI.MapArea.EndY - ControlMargin - ButtonHeight);
+}
+
+static bool IsOnButton(const PixelPos &topLeft, const PixelPos &screenPos,
+                       int width = ButtonWidth, int height = ButtonHeight)
+{
+	return screenPos.x >= topLeft.x && screenPos.x < topLeft.x + width
+	       && screenPos.y >= topLeft.y && screenPos.y < topLeft.y + height;
+}
+
+/// Group button under the screen position, 1 to GroupButtons, or 0.
+static int GroupAt(const PixelPos &screenPos)
+{
+	for (int group = 1; group <= GroupButtons; ++group) {
+		if (IsOnButton(GroupTopLeft(group), screenPos)) {
+			return group;
+		}
+	}
+	return 0;
+}
+
+static bool ControlsShown()
+{
+	return TouchControlsEnabled && GameRunning && !GamePaused;
+}
+
+static bool DeselectShown()
+{
+	return ControlsShown() && !Selected.empty();
+}
+
+static bool IsOnJoystick(const PixelPos &screenPos)
+{
+	const PixelDiff d = screenPos - JoystickCenter();
+	return d.x * d.x + d.y * d.y <= JoystickRadius * JoystickRadius;
+}
+
+/// The square around the joystick, out to the map's edges: touches there
+/// never reach the map, so a thumb near the stick can't select or order.
+static bool IsInJoystickZone(const PixelPos &screenPos)
+{
+	const PixelPos center = JoystickCenter();
+	return screenPos.x >= UI.MapArea.X && screenPos.x <= center.x + JoystickRadius + ControlMargin
+	       && screenPos.y >= center.y - JoystickRadius - ControlMargin && screenPos.y <= UI.MapArea.EndY;
+}
+
+bool TouchControlsDeadZone(const PixelPos &screenPos)
+{
+	return ControlsShown() && IsInJoystickZone(screenPos);
+}
+
+static bool IsOnDeselect(const PixelPos &screenPos);
+
+/// A finger is holding a building to place.
+static bool HoldingBuilding()
+{
+	return CursorBuilding && (TouchBuildHeld() || BuildingFingerHeld) && ControlsShown();
+}
+
+/// Over the deselect or a group button, where a held building isn't placed.
+static bool IsOnBottomButtons(const PixelPos &screenPos)
+{
+	return GroupAt(screenPos) || (DeselectShown() && IsOnDeselect(screenPos));
+}
+
+bool TouchControlsBuildingDrop(const PixelPos &screenPos)
+{
+	if (!ControlsShown()) {
+		return false;
+	}
+	if (DeselectShown() && IsOnDeselect(screenPos)) {
+		// Dropped on the X: cancel, as tapping it does.
+		CancelBuildingMode();
+		GameCursor = UI.Point.Cursor;
+		CursorState = CursorStates::Point;
+		return true;
+	}
+	return GroupAt(screenPos) != 0;
+}
+
+static bool IsOnDeselect(const PixelPos &screenPos)
+{
+	return IsOnButton(DeselectTopLeft(), screenPos, DeselectWidth, DeselectHeight);
+}
+
+/// Save the selected units, if they are the player's, into a group.
+static void SaveGroup(int group)
+{
+	if (Selected.empty() || Selected[0]->Player != ThisPlayer) {
+		return;
+	}
+	for (CUnit *unit : Selected) {
+		if (unit->GroupId) {
+			RemoveUnitFromGroups(*unit);
+		}
+	}
+	SetGroup(&Selected[0], Selected.size(), group);
+	PlayGameSound(GameSounds.Click.Sound.get(), MaxSampleVolume);
+}
+
+/// Select the units saved in a group. Dead units have already left it.
+static void RecallGroup(int group)
+{
+	if (GetUnitsOfGroup(group).empty()) {
+		return;
+	}
+	SelectGroup(group);
+	SelectionChanged();
+
+	// Jump the view to the middle of the group.
+	PixelPos sum(0, 0);
+	int count = 0;
+	for (const CUnit *unit : Selected) {
+		if (unit->IsAliveOnMap()) {
+			sum += unit->GetMapPixelPosCenter();
+			++count;
+		}
+	}
+	if (count) {
+		UI.SelectedViewport->Center(sum / count);
+	}
+}
+
+/// The deselect button first backs out of placing a building, a submenu
+/// such as the build menu, or choosing a target, as the cancel button does;
+/// only when none is under way does it deselect.
+static void PressDeselect()
+{
+	if (CursorBuilding || CurrentButtonLevel != 0 || CursorState == CursorStates::Select) {
+		CancelBuildingMode();
+		GameCursor = UI.Point.Cursor;
+		CursorState = CursorStates::Point;
+		return;
+	}
+	UnSelectAll();
+	NetworkSendSelection(nullptr, 0);
+	SelectionChanged();
+}
+
+/// Puts the knob under the finger, kept within the base.
+static void MoveKnob(const PixelPos &screenPos)
+{
+	PixelDiff d = screenPos - JoystickCenter();
+	const double length = std::sqrt(double(d.x * d.x + d.y * d.y));
+	if (length > JoystickRadius) {
+		d.x = int(d.x * JoystickRadius / length);
+		d.y = int(d.y * JoystickRadius / length);
+	}
+	KnobOffset = d;
+}
+
+static Uint32 Rgb(Uint8 r, Uint8 g, Uint8 b)
+{
+	return Video.MapRGB(TheScreen->format, r, g, b);
+}
+
+/// Repeatable pseudo-random value from 0 to 1 for a pixel or a plank.
+static double Noise(int x, int y, int seed)
+{
+	Uint32 h = Uint32(x) * 374761393u + Uint32(y) * 668265263u + Uint32(seed) * 1442695041u;
+	h = (h ^ (h >> 13)) * 1274126177u;
+	return ((h ^ (h >> 16)) & 0xffff) / 65535.0;
+}
+
+static Uint32 Argb(const SDL_Surface *surface, double r, double g, double b, double a = 1.0)
+{
+	return SDL_MapRGBA(surface->format,
+	                   Uint8(std::clamp(r, 0.0, 255.0)),
+	                   Uint8(std::clamp(g, 0.0, 255.0)),
+	                   Uint8(std::clamp(b, 0.0, 255.0)),
+	                   Uint8(std::clamp(a, 0.0, 1.0) * 255));
+}
+
+static SDL_Surface *MakeSurface(int size)
+{
+	SDL_Surface *surface = SDL_CreateRGBSurfaceWithFormat(0, size, size, 32, SDL_PIXELFORMAT_ARGB8888);
+	if (surface) {
+		SDL_FillRect(surface, nullptr, 0);
+		SDL_SetSurfaceBlendMode(surface, SDL_BLENDMODE_BLEND);
+		SDL_SetSurfaceAlphaMod(surface, JoystickAlpha);
+	}
+	return surface;
+}
+
+/// A line some pixels thick, drawn into a surface.
+static void SurfaceLine(SDL_Surface *surface, PixelPos a, PixelPos b, int thickness, Uint32 color)
+{
+	const int steps = std::max(std::abs(b.x - a.x), std::abs(b.y - a.y));
+	for (int i = 0; i <= steps; ++i) {
+		const int x = a.x + (steps ? (b.x - a.x) * i / steps : 0);
+		const int y = a.y + (steps ? (b.y - a.y) * i / steps : 0);
+		SDL_Rect dot = {x - thickness / 2, y - thickness / 2, thickness, thickness};
+		SDL_FillRect(surface, &dot, color);
+	}
+}
+
+/// A round wooden shield of vertical planks with an iron rim and rivets,
+/// painted once pixel by pixel: wavy grain along each plank, a tone and
+/// knots that differ per plank, seams, light from the top left, an
+/// antialiased edge, and arrow heads around the boss so it reads as a knob
+/// that can be pushed.
+static SDL_Surface *MakeShieldSurface()
+{
+	const int size = 2 * JoystickRadius + 1;
+	SDL_Surface *surface = MakeSurface(size);
+	if (!surface) {
+		return nullptr;
+	}
+	Uint32 *pixels = static_cast<Uint32 *>(surface->pixels);
+	const int pitch = surface->pitch / 4;
+	const int wood = JoystickRadius - RimWidth;
+	// The texture was designed for a shield of radius 40.
+	const double scale = JoystickRadius / 40.0;
+
+	for (int y = 0; y < size; ++y) {
+		for (int x = 0; x < size; ++x) {
+			const int dx = x - JoystickRadius;
+			const int dy = y - JoystickRadius;
+			const double r = std::sqrt(double(dx * dx + dy * dy));
+			const double alpha = std::clamp(JoystickRadius + 0.5 - r, 0.0, 1.0);
+			// 1 at the top left, -1 at the bottom right.
+			const double light = -(dx + dy) / (JoystickRadius * M_SQRT2);
+			double v;
+			if (r > wood) {
+				// Iron, bevelled: bright outer edge facing the light, dark
+				// inner edge where it meets the wood.
+				const double t = (r - wood) / RimWidth;
+				v = 0.40 + 0.16 * light + (Noise(x, y, 7) - 0.5) * 0.08;
+				if (t > 0.75) {
+					v += 0.18 * light + 0.06;
+				} else if (t < 0.3) {
+					v -= 0.14;
+				}
+				pixels[y * pitch + x] = Argb(surface, v * 255, v * 255, v * 255 + 8, alpha);
+				continue;
+			}
+			const int plank = (dx + wood) / PlankWidth;
+			const int px = (dx + wood) % PlankWidth;
+			const double seed = plank * 2.39;
+			const double tone = 0.88 + 0.24 * Noise(plank, 0, 3);
+			const double wave = scale * (1.6 * std::sin(dy * 0.11 / scale + seed)
+			                             + 0.7 * std::sin(dy * 0.37 / scale + seed * 2));
+			const double grain = 0.5 + 0.5 * std::sin((px + wave) * 1.9 / scale + seed);
+			const double fine = 0.5 + 0.5 * std::sin((px + wave * 0.5) * 4.1 + seed * 3);
+			v = tone * (0.82 + 0.16 * grain + 0.06 * fine);
+
+			if (Noise(plank, 2, 9) > 0.35) {
+				const double kx = 3 * scale + Noise(plank, 4, 13) * (PlankWidth - 6 * scale);
+				const double ky = (Noise(plank, 1, 5) - 0.5) * 1.3 * wood;
+				const double kd = std::hypot(px - kx, (dy - ky) * 0.45) / scale;
+				if (kd < 1.5) {
+					v *= 0.5;
+				} else if (kd < 4.5) {
+					v *= 0.86 + 0.12 * std::sin(kd * 2.8);
+				}
+			}
+			v *= 1 + (Noise(x, y, 11) - 0.5) * 0.1;
+			if (px < scale) {
+				v *= 0.5;
+			} else if (px < 2 * scale) {
+				v *= 1.15;
+			}
+			v *= 1 + 0.2 * light;
+			// Darker toward the rim, as if the face were slightly domed.
+			v *= 1 - 0.32 * std::pow(r / wood, 4);
+			pixels[y * pitch + x] = Argb(surface, 156 * v, 100 * v, 52 * v, alpha);
+		}
+	}
+
+	// Domed rivets on the rim: lit top left, shadowed bottom right.
+	const int rivet = static_cast<int>(scale + 0.5);
+	for (int i = 0; i < 8; ++i) {
+		const double angle = i * M_PI / 4 + M_PI / 8;
+		const double r = JoystickRadius - RimWidth / 2.0;
+		const int cx = JoystickRadius + int(std::lround(r * std::cos(angle)));
+		const int cy = JoystickRadius + int(std::lround(r * std::sin(angle)));
+		for (int y = -2 * rivet; y <= 2 * rivet; ++y) {
+			for (int x = -2 * rivet; x <= 2 * rivet; ++x) {
+				const double d = std::hypot(x, y) / (1.6 * rivet);
+				if (d > 1) {
+					continue;
+				}
+				const double shade = 0.55 + 0.45 * (-(x + y) / (2.0 * rivet * M_SQRT2)) + 0.25 * (1 - d);
+				pixels[(cy + y) * pitch + cx + x] = Argb(surface, 210 * shade, 205 * shade, 188 * shade);
+			}
+		}
+	}
+
+	// Arrow heads pointing up, right, down and left.
+	const int tip = wood - static_cast<int>(3 * scale);
+	const int base = KnobRadius + static_cast<int>(4 * scale);
+	const int spread = static_cast<int>(6 * scale);
+	const int thickness = static_cast<int>(scale);
+	const Uint32 shadow = Argb(surface, 60, 34, 12);
+	const Uint32 gold = Argb(surface, 244, 214, 150);
+	const PixelDiff directions[] = {{0, -1}, {1, 0}, {0, 1}, {-1, 0}};
+	const PixelPos center(JoystickRadius, JoystickRadius);
+	for (const auto &[color, shift] : {std::pair(shadow, PixelDiff(thickness, thickness)),
+	                                    std::pair(gold, PixelDiff(0, 0))}) {
+		for (const PixelDiff &d : directions) {
+			const PixelDiff side(-d.y, d.x);
+			const PixelPos a = center + d * tip + shift;
+			const PixelPos b = center + d * base + side * spread + shift;
+			const PixelPos c = center + d * base - side * spread + shift;
+			SurfaceLine(surface, a, b, thickness, color);
+			SurfaceLine(surface, b, c, thickness, color);
+			SurfaceLine(surface, c, a, thickness, color);
+		}
+	}
+	return surface;
+}
+
+/// The shield's iron boss, a shaded metal dome with a soft shadow below it.
+static SDL_Surface *MakeBossSurface()
+{
+	const int shadowShift = KnobRadius / 6;
+	const int size = 2 * KnobRadius + 1 + shadowShift;
+	SDL_Surface *surface = MakeSurface(size);
+	if (!surface) {
+		return nullptr;
+	}
+	Uint32 *pixels = static_cast<Uint32 *>(surface->pixels);
+	const int pitch = surface->pitch / 4;
+	// Light from the top left and slightly in front.
+	const double lx = -0.5;
+	const double ly = -0.6;
+	const double lz = 0.62;
+
+	for (int y = 0; y < size; ++y) {
+		for (int x = 0; x < size; ++x) {
+			const double dx = x - KnobRadius;
+			const double dy = y - KnobRadius;
+			const double r = std::hypot(dx, dy) / KnobRadius;
+			if (r <= 1.0) {
+				const double nz = std::sqrt(std::max(0.0, 1 - r * r));
+				const double diffuse = std::max(0.0, (dx / KnobRadius) * lx + (dy / KnobRadius) * ly + nz * lz);
+				const double shine = std::pow(diffuse, 24);
+				double v = 50 + 150 * diffuse + 120 * shine;
+				// A dark ring where the dome meets the shield.
+				if (r > 0.9) {
+					v *= 0.6;
+				}
+				const double alpha = std::clamp((1.0 - r) * KnobRadius + 0.5, 0.0, 1.0);
+				pixels[y * pitch + x] = Argb(surface, v, v, v + 8, alpha);
+			} else {
+				const double sr = std::hypot(dx - shadowShift, dy - shadowShift) / KnobRadius;
+				if (sr <= 1.0) {
+					pixels[y * pitch + x] = Argb(surface, 0, 0, 0, 0.45 * (1 - sr * sr));
+				}
+			}
+		}
+	}
+	return surface;
+}
+
+static void BlitCentered(SDL_Surface *surface, const PixelPos &center, int radius)
+{
+	if (surface) {
+		SDL_Rect dst = {center.x - radius, center.y - radius, surface->w, surface->h};
+		SDL_BlitSurface(surface, nullptr, TheScreen, &dst);
+	}
+}
+
+static void DrawShield(const PixelPos &center)
+{
+	static SDL_Surface *shield = MakeShieldSurface();
+	BlitCentered(shield, center, JoystickRadius);
+}
+
+/// The shield's iron boss, which is the knob that moves.
+static void DrawBoss(const PixelPos &center)
+{
+	static SDL_Surface *boss = MakeBossSurface();
+	BlitCentered(boss, center, KnobRadius);
+}
+
+
+/// One of the game's buttons cut into a box.
+static void DrawButtonBox(const char *file, const PixelPos &topLeft,
+                          int width = ButtonWidth, int height = ButtonHeight)
+{
+	std::shared_ptr<CGraphic> &graphic = ButtonGraphics[std::string(file) + "@" + std::to_string(height)];
+	if (!graphic) {
+		graphic = CGraphic::ForceNew(file);
+		graphic->Load();
+		// Scale to the box's height, then use both ends so it keeps its bevel.
+		graphic->Resize(graphic->Width * height / graphic->Height, height);
+	}
+	const int half = width / 2;
+	graphic->DrawSubClip(0, 0, half, height, topLeft.x, topLeft.y);
+	graphic->DrawSubClip(graphic->Width - (width - half), 0,
+	                     width - half, height, topLeft.x + half, topLeft.y);
+}
+
+/// The blue button with a gold X on it.
+static void DrawDeselectButton(const PixelPos &topLeft, bool pressed = false)
+{
+	DrawButtonBox(pressed ? BlueButtonPressedFile : BlueButtonFile, topLeft, DeselectWidth, DeselectHeight);
+
+	// Grown with the button, 30% bigger than the group buttons' numbers.
+	const int size = 25;
+	const int shift = pressed ? 1 : 0;
+	const PixelPos a(topLeft.x + (DeselectWidth - size) / 2 + shift, topLeft.y + (DeselectHeight - size) / 2 + shift);
+	const PixelPos b = a + PixelDiff(size, size);
+	const Uint32 shadow = Rgb(40, 24, 0);
+	const Uint32 gold = Rgb(252, 204, 52);
+	const Uint32 shine = Rgb(255, 240, 150);
+	for (int i = -1; i <= 1; ++i) {
+		Video.DrawLineClip(shadow, PixelPos(a.x + i + 1, a.y + 1), PixelPos(b.x + i + 1, b.y + 1));
+		Video.DrawLineClip(shadow, PixelPos(b.x + i + 1, a.y + 1), PixelPos(a.x + i + 1, b.y + 1));
+	}
+	for (int i = -1; i <= 1; ++i) {
+		const Uint32 color = i < 0 ? shine : gold;
+		Video.DrawLineClip(color, PixelPos(a.x + i, a.y), PixelPos(b.x + i, b.y));
+		Video.DrawLineClip(color, PixelPos(b.x + i, a.y), PixelPos(a.x + i, b.y));
+	}
+}
+
+/// A group button: blue when units are saved in it, burgundy when empty.
+static void DrawGroupButton(int group)
+{
+	const bool used = !GetUnitsOfGroup(group).empty();
+	const bool pressed = PressedGroup == group;
+	const char *file = used ? (pressed ? BlueButtonPressedFile : BlueButtonFile)
+	                        : (pressed ? RedButtonPressedFile : RedButtonFile);
+	const PixelPos topLeft = GroupTopLeft(group);
+	DrawButtonBox(file, topLeft);
+
+	// The episode title font, in gold, is about as tall as the X.
+	const CFont *font = CFont::Get("small-title");
+	const CLabel label(font ? *font : GetGameFont(), "yellow", "yellow");
+	const int shift = pressed ? 1 : 0;
+	label.DrawCentered(topLeft.x + ButtonWidth / 2 + shift,
+	                   topLeft.y + (ButtonHeight - label.Height()) / 2 + shift,
+	                   std::to_string(group));
+}
+
+/**
+**  Draw the joystick and, when units are selected, the deselect button.
+*/
+void DrawTouchControls()
+{
+	if (!ControlsShown()) {
+		return;
+	}
+	const PixelPos center = JoystickCenter();
+	DrawShield(center);
+	DrawBoss(center + KnobOffset);
+
+	for (int group = 1; group <= GroupButtons; ++group) {
+		DrawGroupButton(group);
+	}
+	if (DeselectShown()) {
+		const PixelPos topLeft = DeselectTopLeft();
+		const bool holding = HoldingBuilding();
+		DrawDeselectButton(topLeft, holding && IsOnDeselect(BuildingCursorScreenPos()));
+		if (holding) {
+			// A gold frame: drop the building here to cancel it.
+			const Uint32 gold = Rgb(252, 204, 52);
+			const Uint32 dark = Rgb(120, 80, 0);
+			for (int i = 2; i <= 4; ++i) {
+				Video.DrawRectangleClip(i == 4 ? dark : gold, topLeft.x - i, topLeft.y - i,
+				                        DeselectWidth + 2 * i, DeselectHeight + 2 * i);
+			}
+		}
+	}
+}
+
+/**
+**  Handle a press on the controls.
+**
+**  @return  True if the press was on a control and must not reach the map.
+*/
+bool TouchControlsButtonDown(const PixelPos &screenPos)
+{
+	if (!ControlsShown()) {
+		return false;
+	}
+	// Holding a control still sends a long press, which mustn't start
+	// a selection box.
+	if ((JoystickHeld && !JoystickByFinger) || PressedGroup) {
+		return true;
+	}
+	if (JoystickByFinger && IsInJoystickZone(screenPos)) {
+		PointerPressIgnored = true;
+		return true;
+	}
+	if (const int group = GroupAt(screenPos)) {
+		PressedGroup = group;
+		PressedGroupTicks = SDL_GetTicks();
+		PressedGroupSaved = false;
+		return true;
+	}
+	if (DeselectShown() && IsOnDeselect(screenPos)) {
+		PressDeselect();
+		return true;
+	}
+	if (IsOnJoystick(screenPos)) {
+		JoystickHeld = true;
+		LastScrollTicks = SDL_GetTicks();
+		ScrollRemainderX = ScrollRemainderY = 0;
+		MoveKnob(screenPos);
+		return true;
+	}
+	if (IsInJoystickZone(screenPos)) {
+		// Beside the stick: ignored, along with its moves and release.
+		PointerPressIgnored = true;
+		return true;
+	}
+	return false;
+}
+
+/**
+**  Follow the finger while the joystick is held.
+**
+**  @return  True if the joystick is held and the move must not reach the map.
+*/
+bool TouchControlsMouseMove(const PixelPos &screenPos)
+{
+	if (PressedGroup || PointerPressIgnored) {
+		return true;
+	}
+	if (!JoystickHeld || JoystickByFinger) {
+		return false;
+	}
+	MoveKnob(screenPos);
+	return true;
+}
+
+static void ReleaseJoystick()
+{
+	JoystickHeld = false;
+	JoystickByFinger = false;
+	KnobOffset = PixelDiff(0, 0);
+}
+
+/**
+**  Let go of the joystick or a group button. A short press on a group
+**  button selects its units.
+**
+**  @return  True if a control was held and the release must not reach the map.
+*/
+bool TouchControlsButtonUp()
+{
+	if (PressedGroup) {
+		if (!PressedGroupSaved) {
+			RecallGroup(PressedGroup);
+		}
+		PressedGroup = 0;
+		return true;
+	}
+	if (PointerPressIgnored) {
+		PointerPressIgnored = false;
+		return true;
+	}
+	if (!JoystickHeld || JoystickByFinger) {
+		return false;
+	}
+	ReleaseJoystick();
+	return true;
+}
+
+/**
+**  Scroll the map at an even speed in the direction the joystick points.
+**  Called once per displayed frame.
+*/
+/// How close to the edge of the map view a finger or the building it holds
+/// must come to scroll the view, in screen pixels.
+static constexpr int EdgeScrollBand = 24;
+static constexpr double EdgeScrollSpeed = 360;
+static Uint32 EdgeScrollTicks = 0;
+static double EdgeRemainderX = 0;
+static double EdgeRemainderY = 0;
+
+/**
+**  While a finger holds a building to place, scroll the view when the finger
+**  comes near the right or bottom edge, or the building, which shows above
+**  and left of the finger, comes near the left or top edge.
+*/
+static void EdgeScroll()
+{
+	const bool holding = CursorBuilding && (TouchBuildHeld() || BuildingFingerHeld)
+	                     && ControlsShown() && !TouchControlsPinching();
+	const Uint32 now = SDL_GetTicks();
+	const double seconds = std::min((now - EdgeScrollTicks) / 1000.0, 0.1);
+	const bool started = EdgeScrollTicks != 0;
+	EdgeScrollTicks = holding ? now : 0;
+	if (!holding || !started) {
+		EdgeRemainderX = EdgeRemainderY = 0;
+		return;
+	}
+	CViewport &vp = *UI.SelectedViewport;
+	const PixelPos finger = BuildingCursorScreenPos();
+	if (IsOnBottomButtons(finger)) {
+		// Heading for the X or a group button, not for the edge.
+		EdgeRemainderX = EdgeRemainderY = 0;
+		return;
+	}
+	const PixelPos building = vp.TilePosToScreen_TopLeft(BuildingCursorTilePos());
+	const PixelPos topLeft = vp.GetTopLeftPos();
+	const PixelPos bottomRight = vp.GetBottomRightPos();
+	int dx = 0;
+	int dy = 0;
+	if (finger.x >= bottomRight.x - EdgeScrollBand) {
+		dx = 1;
+	} else if (building.x <= topLeft.x + EdgeScrollBand || finger.x <= topLeft.x + EdgeScrollBand) {
+		dx = -1;
+	}
+	if (finger.y >= bottomRight.y - EdgeScrollBand) {
+		dy = 1;
+	} else if (building.y <= topLeft.y + EdgeScrollBand || finger.y <= topLeft.y + EdgeScrollBand) {
+		dy = -1;
+	}
+	if (!dx && !dy) {
+		EdgeRemainderX = EdgeRemainderY = 0;
+		return;
+	}
+	EdgeRemainderX += dx * EdgeScrollSpeed * seconds / vp.Zoom;
+	EdgeRemainderY += dy * EdgeScrollSpeed * seconds / vp.Zoom;
+	const PixelDiff step(static_cast<int>(EdgeRemainderX), static_cast<int>(EdgeRemainderY));
+	EdgeRemainderX -= step.x;
+	EdgeRemainderY -= step.y;
+	if (step.x || step.y) {
+		vp.Set(vp.MapPos, vp.Offset + step);
+	}
+}
+
+void TouchControlsScroll()
+{
+	// Save into a group once its button has been held long enough, so the
+	// button turns blue while the finger is still on it.
+	if (PressedGroup && !PressedGroupSaved && SDL_GetTicks() - PressedGroupTicks >= GroupHoldMs) {
+		SaveGroup(PressedGroup);
+		PressedGroupSaved = true;
+	}
+	EdgeScroll();
+	if (!JoystickHeld) {
+		return;
+	}
+	if (!ControlsShown()) {
+		ReleaseJoystick();
+		return;
+	}
+	const Uint32 now = SDL_GetTicks();
+	const double seconds = (now - LastScrollTicks) / 1000.0;
+	LastScrollTicks = now;
+
+	const double length = std::sqrt(double(KnobOffset.x * KnobOffset.x + KnobOffset.y * KnobOffset.y));
+	if (length < JoystickDeadZone) {
+		return;
+	}
+	// Even speed on screen, whatever the zoom.
+	CViewport *vp = UI.SelectedViewport;
+	ScrollRemainderX += KnobOffset.x / length * JoystickScrollSpeed * seconds / vp->Zoom;
+	ScrollRemainderY += KnobOffset.y / length * JoystickScrollSpeed * seconds / vp->Zoom;
+	const PixelDiff step(static_cast<int>(ScrollRemainderX), static_cast<int>(ScrollRemainderY));
+	ScrollRemainderX -= step.x;
+	ScrollRemainderY -= step.y;
+	if (step.x || step.y) {
+		vp->Set(vp->MapPos, vp->Offset + step);
+	}
+}
+
+/*----------------------------------------------------------------------------
+--  Pinch zoom
+----------------------------------------------------------------------------*/
+
+/// Most the map can be enlarged.
+static constexpr double MaxZoom = 2.0;
+/// Zoom this close to 1 snaps to 1, where drawing is cheapest.
+static constexpr double ZoomSnap = 0.05;
+
+/// Fingers on the screen, in screen pixels.
+static std::map<SDL_FingerID, PixelPrecise> Fingers;
+/// A pinch is under way: set when a second finger lands on the map, and
+/// kept until every finger has left the screen.
+static bool Pinching = false;
+static double PinchStartDistance = 0;
+static double PinchStartZoom = 1;
+/// The map point under the middle of the two fingers, kept under them.
+static PixelPrecise PinchAnchor;
+
+/// Smallest zoom: the whole map width or height fills the view, whichever
+/// comes first, and never smaller than the map's normal size if it fits.
+static double MinZoom(const CViewport &vp)
+{
+	const PixelSize screen = vp.GetBottomRightPos() - vp.GetTopLeftPos();
+	const double fitX = double(screen.x) / (Map.Info.MapWidth * PixelTileSize.x);
+	const double fitY = double(screen.y) / (Map.Info.MapHeight * PixelTileSize.y);
+	return std::min(1.0, std::max(fitX, fitY));
+}
+
+static std::pair<PixelPrecise, double> PinchMiddleAndDistance()
+{
+	auto it = Fingers.begin();
+	const PixelPrecise a = it->second;
+	const PixelPrecise b = (++it)->second;
+	return {PixelPrecise((a.x + b.x) / 2, (a.y + b.y) / 2), std::hypot(a.x - b.x, a.y - b.y)};
+}
+
+static bool IsOnMap(const PixelPrecise &pos)
+{
+	const PixelPos screenPos(static_cast<int>(pos.x), static_cast<int>(pos.y));
+	return UI.SelectedViewport->Contains(screenPos) && !IsInJoystickZone(screenPos)
+	       && !GroupAt(screenPos) && !(DeselectShown() && IsOnDeselect(screenPos));
+}
+
+static void StartPinch()
+{
+	CViewport &vp = *UI.SelectedViewport;
+	const auto [middle, distance] = PinchMiddleAndDistance();
+	if (distance < 1) {
+		return;
+	}
+	Pinching = true;
+	PinchStartDistance = distance;
+	PinchStartZoom = vp.Zoom;
+	const PixelPos mapTopLeft = Map.TilePosToMapPixelPos_TopLeft(vp.MapPos) + vp.Offset;
+	PinchAnchor = PixelPrecise(mapTopLeft.x + (middle.x - vp.GetTopLeftPos().x) / vp.Zoom,
+	                         mapTopLeft.y + (middle.y - vp.GetTopLeftPos().y) / vp.Zoom);
+	vp.Unit = nullptr;
+	// The first finger already pressed the mouse: forget the selection box
+	// or anything else it began.
+	CursorState = CursorStates::Point;
+	GameCursor = UI.Point.Cursor;
+}
+
+static void UpdatePinch()
+{
+	CViewport &vp = *UI.SelectedViewport;
+	const auto [middle, distance] = PinchMiddleAndDistance();
+	double zoom = std::clamp(PinchStartZoom * distance / PinchStartDistance, MinZoom(vp), MaxZoom);
+	if (std::abs(zoom - 1.0) < ZoomSnap) {
+		zoom = 1.0;
+	}
+	vp.Zoom = zoom;
+	// Keep the anchor under the fingers, so the pinch also pans.
+	const PixelDiff mapTopLeft(static_cast<int>(PinchAnchor.x - (middle.x - vp.GetTopLeftPos().x) / zoom),
+	                           static_cast<int>(PinchAnchor.y - (middle.y - vp.GetTopLeftPos().y) / zoom));
+	vp.Set(Vec2i(0, 0), mapTopLeft);
+}
+
+/// Longest press and largest wobble that still count as a tap.
+static constexpr Uint32 ExtraTapMs = 600;
+static constexpr double ExtraTapSlop = 12;
+
+/// A finger that went down while another held the joystick. Only the first
+/// finger drives the pointer, so taps from these are handled here.
+struct ExtraFinger
+{
+	PixelPrecise Start;
+	Uint32 Ticks;
+};
+static std::map<SDL_FingerID, ExtraFinger> ExtraFingers;
+
+/// A tap from an extra finger: on a control it presses it, on the map it
+/// does what a tap there would.
+static void ExtraTap(const PixelPrecise &pos)
+{
+	const PixelPos screenPos(static_cast<int>(pos.x), static_cast<int>(pos.y));
+	if (DeselectShown() && IsOnDeselect(screenPos)) {
+		PressDeselect();
+	} else if (const int group = GroupAt(screenPos)) {
+		RecallGroup(group);
+	} else if (!IsInJoystickZone(screenPos)) {
+		MapTapAt(screenPos);
+	}
+}
+
+/**
+**  Follow the fingers for pinch zoom on the map, and for taps from a second
+**  finger while the first holds the joystick.
+*/
+void TouchControlsFinger(const SDL_TouchFingerEvent &event)
+{
+	const PixelPrecise pos(event.x * Video.Width, event.y * Video.Height);
+	const PixelPos screenPos(static_cast<int>(pos.x), static_cast<int>(pos.y));
+	switch (event.type) {
+		case SDL_FINGERDOWN:
+			if (ControlsShown() && CursorBuilding && TouchBuildHeld() && !JoystickHeld
+			    && IsOnJoystick(screenPos)) {
+				// The pointer's finger holds a building: this one scrolls.
+				JoystickHeld = true;
+				JoystickByFinger = true;
+				JoystickFingerId = event.fingerId;
+				LastScrollTicks = SDL_GetTicks();
+				ScrollRemainderX = ScrollRemainderY = 0;
+				MoveKnob(screenPos);
+			} else if (ControlsShown() && CursorBuilding && JoystickHeld && !JoystickByFinger
+			           && !BuildingFingerHeld && IsOnMap(pos)) {
+				// The pointer's finger holds the joystick: this one holds the
+				// building and places it on release.
+				BuildingFingerHeld = true;
+				BuildingFingerId = event.fingerId;
+				BuildingFingerPos = screenPos;
+			} else if (JoystickHeld && !JoystickByFinger && ControlsShown()) {
+				ExtraFingers[event.fingerId] = {pos, SDL_GetTicks()};
+			}
+			Fingers[event.fingerId] = pos;
+			if (!Pinching && Fingers.size() == 2 && ControlsShown() && !JoystickHeld && !PressedGroup
+			    && !CursorBuilding
+			    && IsOnMap(Fingers.begin()->second) && IsOnMap(std::next(Fingers.begin())->second)) {
+				StartPinch();
+			}
+			break;
+		case SDL_FINGERMOTION:
+			Fingers[event.fingerId] = pos;
+			if (JoystickByFinger && event.fingerId == JoystickFingerId) {
+				MoveKnob(screenPos);
+			}
+			if (BuildingFingerHeld && event.fingerId == BuildingFingerId) {
+				BuildingFingerPos = screenPos;
+			}
+			if (Pinching && Fingers.size() == 2 && ControlsShown()) {
+				UpdatePinch();
+			}
+			break;
+		case SDL_FINGERUP:
+			if (JoystickByFinger && event.fingerId == JoystickFingerId) {
+				ReleaseJoystick();
+			}
+			if (BuildingFingerHeld && event.fingerId == BuildingFingerId) {
+				BuildingFingerPos = screenPos;
+				if (!TouchControlsBuildingDrop(screenPos) && IsOnMap(pos) && ControlsShown()) {
+					TouchPlaceBuilding();
+				}
+				BuildingFingerHeld = false;
+			}
+			if (auto extra = ExtraFingers.find(event.fingerId); extra != ExtraFingers.end()) {
+				const ExtraFinger finger = extra->second;
+				ExtraFingers.erase(extra);
+				if (SDL_GetTicks() - finger.Ticks <= ExtraTapMs
+				    && std::hypot(pos.x - finger.Start.x, pos.y - finger.Start.y) <= ExtraTapSlop
+				    && ControlsShown()) {
+					ExtraTap(pos);
+				}
+			}
+			Fingers.erase(event.fingerId);
+			if (Fingers.empty()) {
+				Pinching = false;
+			}
+			break;
+		default:
+			break;
+	}
+}
+
+/**
+**  Whether a pinch owns the touches, so the mouse events made from the
+**  first finger must be ignored.
+*/
+bool TouchControlsPinching()
+{
+	return Pinching;
+}
+
+//@}
