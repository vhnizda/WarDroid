 	lua_register(Lua, "NetworkDiscoverServers", CclNetworkDiscoverServers);
+	lua_register(Lua, "NetworkScanLan", CclNetworkScanLan);
+	lua_register(Lua, "NetworkLocalIps", CclNetworkLocalIps);
 }
 
 
