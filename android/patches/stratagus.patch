+		return false;
+	}
+	if (!ranges::all_of(Selected, [](const CUnit *unit) { return unit->Player == ThisPlayer; })) {
+		return false;
+	}
+	if (dest != nullptr && ThisPlayer->IsEnemy(*dest) && dest->IsVisibleAsGoal(*ThisPlayer)) {
+		return ranges::any_of(Selected, [](const CUnit *unit) { return unit->Type->CanAttack; });
+	}
+	bool useful = false;
+	for (const CUnit *unit : Selected) {
+		const CUnitType &type = *unit->Type;
+		if (unit->Player != ThisPlayer || type.MouseAction != EMouseAction::Harvest) {
+			return false;
+		}
+		if (dest != nullptr) {
+			if (type.RepairRange && dest->Type->RepairHP
+				&& dest->Variable[HP_INDEX].Value < dest->Variable[HP_INDEX].Max
+				&& (dest->Player == unit->Player || unit->IsAllied(*dest))) {
+				useful = true;
+			}
+			const int res = dest->Type->GivesResource;
+			if (type.BoolFlag[HARVESTER_INDEX].value && res && type.ResInfo[res]
+				&& dest->Type->BoolFlag[CANHARVEST_INDEX].value
+				&& (dest->Player == unit->Player || dest->Player->Index == PlayerNumNeutral)) {
+				useful = true;
+			}
+		} else if (type.BoolFlag[HARVESTER_INDEX].value
+		           && Map.Field(pos)->playerInfo.IsExplored(*unit->Player)) {
+			for (int res = 0; res < MaxCosts; ++res) {
+				if (type.ResInfo[res] && type.ResInfo[res]->TerrainHarvester
+					&& Map.Field(pos)->IsTerrainResourceOnMap(res)) {
+					useful = true;
+				}
+			}
+		}
+	}
+	return useful;
+}
