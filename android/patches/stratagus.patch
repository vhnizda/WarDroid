+/**
+**  Draw the player resources in the top line, enlarged by UI.ResourceScale.
+**  Resource positions are set for the line at its normal size. Those on the
+**  left half of the screen grow rightwards from the line's left end, those
+**  on the right half grow leftwards from the right edge of the screen.
+*/
+void DrawResources()
+{
+	const int scale = UI.ResourceScale;
+	if (scale <= 0 || scale == 100) {
+		DrawResourcesLine();
+		return;
+	}
+	const int width = Video.Width;
+	const int scaledHeight = UI.MapArea.Y;
+	const int height = std::max(1, scaledHeight * 100 / scale);
+	static SDL_Surface *buffer = nullptr;
+	SDL_Surface *line = DrawOffscreen(buffer, width, height, DrawResourcesLine);
+	if (!line) {
+		return;
+	}
+	const int left = UI.MapArea.X;
+	int split = width;
+	for (int i = 0; i <= FreeWorkersCount; ++i) {
+		const int x = UI.Resources[i].IconX;
+		if (x >= width / 2 && x - 2 < split) {
+			split = x - 2;
+		}
+	}
+	const int leftWidth = split - left;
+	const int rightWidth = width - split;
+	SDL_Rect clip = {left, 0, width - left, scaledHeight};
+	SDL_SetClipRect(TheScreen, &clip);
+	if (leftWidth > 0) {
+		SDL_Rect src = {left, 0, leftWidth, height};
+		SDL_Rect dst = {left, 0, leftWidth * scale / 100, scaledHeight};
+		SDL_BlitScaled(line, &src, TheScreen, &dst);
+	}
+	if (rightWidth > 0) {
+		SDL_Rect src = {split, 0, rightWidth, height};
+		SDL_Rect dst = {width - rightWidth * scale / 100, 0, rightWidth * scale / 100, scaledHeight};
+		SDL_BlitScaled(line, &src, TheScreen, &dst);
+	}
+	SDL_SetClipRect(TheScreen, nullptr);
+}
