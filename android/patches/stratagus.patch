+/**
+**  Draw a zoomed viewport. Everything is drawn as usual, at map scale, onto
+**  a canvas the size of the map area shown, standing in for the screen; the
+**  canvas is then scaled into the viewport on the real screen.
+*/
+void CViewport::DrawZoomed(const fieldHighlightChecker highlightChecker)
+{
+	const PixelPos screenTopLeft = this->TopLeftPos;
+	const PixelPos screenBottomRight = this->BottomRightPos;
+	const double zoom = this->Zoom;
+	const int screenWidth = screenBottomRight.x - screenTopLeft.x + 1;
+	const int screenHeight = screenBottomRight.y - screenTopLeft.y + 1;
+	const int width = static_cast<int>(std::ceil(screenWidth / zoom));
+	const int height = static_cast<int>(std::ceil(screenHeight / zoom));
+
+	if (!ZoomSurface || ZoomSurface->w != width || ZoomSurface->h != height) {
+		if (ZoomSurface) {
+			SDL_FreeSurface(ZoomSurface);
+		}
+		ZoomSurface = SDL_CreateRGBSurface(0, width, height, 32, TheScreen->format->Rmask,
+		                                   TheScreen->format->Gmask, TheScreen->format->Bmask, 0);
+		if (!ZoomSurface) {
+			return;
+		}
+	}
+	SDL_FillRect(ZoomSurface, nullptr, 0);
+
+	// The line drawing code takes the screen's width as its pitch.
+	SDL_Surface *screen = TheScreen;
+	const int videoWidth = Video.Width;
+	const int videoHeight = Video.Height;
+	TheScreen = ZoomSurface;
+	Video.Width = width;
+	Video.Height = height;
+	this->TopLeftPos = PixelPos(0, 0);
+	this->BottomRightPos = PixelPos(width - 1, height - 1);
+	this->Zoom = 1.0;
+	this->Set(this->MapPos, this->Offset);
+
+	PushClipping();
+	::SetClipping(0, 0, width - 1, height - 1);
+	this->Draw(highlightChecker);
+	PopClipping();
+
+	TheScreen = screen;
+	Video.Width = videoWidth;
+	Video.Height = videoHeight;
+	this->TopLeftPos = screenTopLeft;
+	this->BottomRightPos = screenBottomRight;
+	this->Zoom = zoom;
+	this->Set(this->MapPos, this->Offset);
+
+	SDL_Rect src = {0, 0, width, height};
+	SDL_Rect dst = {screenTopLeft.x, screenTopLeft.y, static_cast<int>(width * zoom),
+	                static_cast<int>(height * zoom)};
+	SDL_Rect clip = {screenTopLeft.x, screenTopLeft.y, screenWidth, screenHeight};
+	SDL_SetClipRect(TheScreen, &clip);
+	SDL_BlitScaled(ZoomSurface, &src, TheScreen, &dst);
+	SDL_SetClipRect(TheScreen, nullptr);
+}
