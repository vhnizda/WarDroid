+/**
+**  Probe every address in the local subnets for hosts answering LAN search.
+**  Takes about a second.
+**
+**  @param l  Lua state.
+**
+**  @return Table of "ip:port" strings.
+*/
+static int CclNetworkScanLan(lua_State *l)
+{
+	LuaCheckArgs(l, 0);
+	lua_newtable(l);
+
+	Socket sockfd = NetOpenUDP(INADDR_ANY, 0);
+	if (sockfd == static_cast<Socket>(-1)) {
+		return 1;
+	}
+	const int on = 1;
+	setsockopt(sockfd, SOL_SOCKET, SO_BROADCAST, (const char *)&on, sizeof(on));
+
+	std::vector<unsigned long> ownIps;
+	std::vector<unsigned long> targets;
+	for (const auto &[ip, mask] : NetSocketSubnets()) {
+		ownIps.push_back(ip);
+		const uint32_t hostIp = ntohl(ip);
+		uint32_t hostMask = ntohl(mask);
+		// Limit big networks to the 254 addresses around this device.
+		if (hostMask < 0xFFFFFC00) {
+			hostMask = 0xFFFFFF00;
+		}
+		const uint32_t net = hostIp & hostMask;
+		const uint32_t broadcast = net | ~hostMask;
+		for (uint32_t addr = net + 1; addr < broadcast; ++addr) {
+			if (addr != hostIp) {
+				targets.push_back(htonl(addr));
+			}
+		}
+		targets.push_back(htonl(broadcast));
+	}
+
+	const std::string probe = LanSearchProbe + GameName;
+	const std::string answer = LanSearchAnswer + GameName + " ";
+	std::set<std::string> found;
+	// Repeat, as the first packet to a new address can be lost while it is looked up.
+	for (int round = 0; round < 3; ++round) {
+		for (auto target : targets) {
+			NetSendUDP(sockfd, target, LanSearchPort, probe.data(), probe.size());
+		}
+		const auto until = std::chrono::steady_clock::now() + std::chrono::milliseconds(400);
+		while (true) {
+			const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(until - std::chrono::steady_clock::now()).count();
+			if (left <= 0 || NetSocketReady(sockfd, static_cast<int>(left)) <= 0) {
+				break;
+			}
+			char buf[64];
+			unsigned long host;
+			int port;
+			const int len = NetRecvUDP(sockfd, buf, sizeof(buf), &host, &port);
+			if (len <= 0) {
+				continue;
+			}
+			const std::string reply(buf, len);
+			if (reply.compare(0, answer.size(), answer) != 0
+				|| std::find(ownIps.begin(), ownIps.end(), host) != ownIps.end()) {
+				continue;
+			}
+			const int gamePort = atoi(reply.c_str() + answer.size());
+			if (gamePort <= 0 || gamePort > 65535) {
+				continue;
+			}
+			char ip[24];
+			sprintf(ip, "%d.%d.%d.%d", NIPQUAD(ntohl(host)));
+			found.insert(std::string(ip) + ":" + std::to_string(gamePort));
+		}
+	}
+	NetCloseUDP(sockfd);
+
+	int i = 1;
+	for (const auto &server : found) {
+		lua_pushnumber(l, i++);
+		lua_pushstring(l, server.c_str());
+		lua_settable(l, -3);
+	}
+	return 1;
+}
+
+/**
+**  Addresses of this device, so a host can tell players what to join.
+**
+**  @param l  Lua state.
+**
+**  @return Table of IP strings.
+*/
+static int CclNetworkLocalIps(lua_State *l)
+{
+	LuaCheckArgs(l, 0);
+	lua_newtable(l);
+	int i = 1;
+	for (auto ip : NetSocketAddr()) {
+		char buf[24];
+		sprintf(buf, "%d.%d.%d.%d", NIPQUAD(ntohl(ip)));
+		lua_pushnumber(l, i++);
+		lua_pushstring(l, buf);
+		lua_settable(l, -3);
+	}
+	return 1;
+}
+
 
