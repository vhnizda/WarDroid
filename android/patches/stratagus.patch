+/**
+**  Center the view on this player's base: their first town hall (a building
+**  that takes in gold), else the middle of their buildings, else of their
+**  units. Loading leaves the view in the top left corner of the map.
+*/
+static void CenterViewOnPlayerBase()
+{
+	if (ThisPlayer == nullptr || UI.SelectedViewport == nullptr) {
+		return;
+	}
+	const CUnit *hall = nullptr;
+	long buildingX = 0, buildingY = 0, unitX = 0, unitY = 0;
+	int buildings = 0, units = 0;
+	for (const CUnit *unit : ThisPlayer->GetUnits()) {
+		if (unit->Removed || unit->Destroyed || !unit->IsAlive()) {
+			continue;
+		}
+		const PixelPos pos = unit->GetMapPixelPosCenter();
+		if (unit->Type->Building) {
+			if (hall == nullptr && unit->Type->CanStore[GoldCost]) {
+				hall = unit;
+			}
+			buildingX += pos.x;
+			buildingY += pos.y;
+			++buildings;
+		} else {
+			unitX += pos.x;
+			unitY += pos.y;
+			++units;
+		}
+	}
+	if (hall != nullptr) {
+		UI.SelectedViewport->Center(hall->GetMapPixelPosCenter());
+	} else if (buildings) {
+		UI.SelectedViewport->Center(PixelPos(buildingX / buildings, buildingY / buildings));
+	} else if (units) {
+		UI.SelectedViewport->Center(PixelPos(unitX / units, unitY / units));
+	}
+}
