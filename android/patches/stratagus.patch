+/**
+**  Run draw() with an offscreen surface of w x h as the screen, cleared to
+**  see-through, and return that surface for blitting, scaled, to the screen. The
+**  surface is kept in buffer between calls.
+*/
+static SDL_Surface *DrawOffscreen(SDL_Surface *&buffer, int w, int h, const std::function<void()> &draw)
+{
+	if (!buffer || buffer->w != w || buffer->h != h
+	    || buffer->format->format != TheScreen->format->format) {
+		if (buffer) {
+			SDL_FreeSurface(buffer);
+		}
+		buffer = SDL_CreateRGBSurface(0, w, h, 32, TheScreen->format->Rmask,
+		                              TheScreen->format->Gmask, TheScreen->format->Bmask, 0);
+		if (!buffer) {
+			return nullptr;
+		}
+	}
+	const Uint32 seeThrough = SDL_MapRGB(buffer->format, 255, 0, 255);
+	SDL_FillRect(buffer, nullptr, seeThrough);
+	SDL_SetColorKey(buffer, SDL_TRUE, seeThrough);
+
+	// The line drawing code takes the screen's width as its pitch.
+	SDL_Surface *screen = TheScreen;
+	const int videoWidth = Video.Width;
+	const int videoHeight = Video.Height;
+	TheScreen = buffer;
+	Video.Width = w;
+	Video.Height = h;
+	PushClipping();
+	SetClipping(0, 0, w - 1, h - 1);
+	draw();
+	PopClipping();
+	TheScreen = screen;
+	Video.Width = videoWidth;
+	Video.Height = videoHeight;
+	return buffer;
+}
