+/**
+**  Order the selected units as a right click would, for a smart click.
+**  Every unit goes for the clicked tile, without the formation offsets that
+**  a right click on open ground uses.
+*/
+static void DoSmartClick(CUnit *dest, const Vec2i &pos, const PixelPos &mapPixelPos)
+{
+	if (dest == nullptr && !ClickMissile.empty()) {
+		MakeLocalMissile(MissileTypeByIdent(ClickMissile), mapPixelPos, mapPixelPos);
+	}
+	int acknowledged = 0;
+	for (CUnit *unit : Selected) {
+		DoRightButton_ForSelectedUnit(*unit, dest, pos, acknowledged);
+	}
+	ShowOrdersCount = GameCycle + Preference.ShowOrders * CYCLES_PER_SECOND;
+}
+
+/**
+**  A tap on the map from a finger other than the one driving the pointer,
+**  such as while the other finger holds the joystick. It does what a plain
+**  click there would: a smart click, else select the unit tapped, else move
+**  the selection there.
+**
+**  @param screenPos  Screen position tapped.
+*/
+void MapTapAt(const PixelPos &screenPos)
+{
+	if (GameObserve || GamePaused || GameEstablishing) {
+		return;
+	}
+	CViewport &vp = *UI.SelectedViewport;
+	if (!vp.Contains(screenPos) || !vp.IsInsideMapArea(screenPos)) {
+		return;
+	}
+	const PixelPos mapPixelPos = vp.ScreenToMapPixelPos(screenPos);
+	const Vec2i tilePos = Map.MapPixelPosToTilePos(mapPixelPos);
+
+	CUnit *dest = nullptr;
+	if (ReplayRevealMap || Map.Field(tilePos)->playerInfo.IsExplored(*ThisPlayer)) {
+		dest = UnitOnScreen(mapPixelPos.x, mapPixelPos.y);
+	}
+	if (dest != nullptr && ((!dest->IsVisibleAsGoal(*ThisPlayer) && !ReplayRevealMap)
+	                        || dest->Type->BoolFlag[DECORATION_INDEX].value)) {
+		dest = nullptr;
+	}
+
+	// The orders below look at the unit under the cursor, which belongs to
+	// the other finger.
+	CUnit *const pointerUnit = UnitUnderCursor;
+	UnitUnderCursor = dest;
+	if (IsSmartClick(dest, tilePos)) {
+		DoSmartClick(dest, tilePos, mapPixelPos);
+	} else if (dest != nullptr
+	           && (ReplayRevealMap || Map.Field(tilePos)->playerInfo.IsTeamVisible(*ThisPlayer))) {
+		SelectSingleUnit(*dest);
+		UI.StatusLine.Clear();
+		UI.StatusLine.ClearCosts();
+		CurrentButtonLevel = 0;
+		SelectionChanged();
+		if (dest->Player == ThisPlayer) {
+			PlayUnitSound(*dest, EUnitVoice::Selected);
+		} else {
+			PlayGameSound(GameSounds.Click.Sound.get(), MaxSampleVolume);
+		}
+	} else if (dest == nullptr && !Selected.empty()
+	           && ranges::all_of(Selected, [](const CUnit *unit) {
+		              return unit->Player == ThisPlayer && unit->CanMove();
+	              })) {
+		if (!ClickMissile.empty()) {
+			MakeLocalMissile(MissileTypeByIdent(ClickMissile), mapPixelPos, mapPixelPos);
+		}
+		DoRightButton(mapPixelPos);
+	}
+	UnitUnderCursor = pointerUnit;
+}
