+#elif defined(__ANDROID__) // } {
+// getifaddrs needs Android 7, so ask the kernel directly, which works on all versions.
+std::vector<std::pair<unsigned long, unsigned long>> NetSocketSubnets()
+{
+	std::vector<std::pair<unsigned long, unsigned long>> subnets;
+	const int sockfd = socket(AF_INET, SOCK_DGRAM, 0);
+	if (sockfd < 0) {
+		return subnets;
+	}
+	struct ifreq ifr[32];
+	struct ifconf ifc{};
+	ifc.ifc_len = sizeof(ifr);
+	ifc.ifc_req = ifr;
+	if (ioctl(sockfd, SIOCGIFCONF, &ifc) == 0) {
+		const int count = ifc.ifc_len / sizeof(struct ifreq);
+		for (int i = 0; i < count; ++i) {
+			struct ifreq req = ifr[i];
+			if (req.ifr_addr.sa_family != AF_INET) continue;
+			const unsigned long ip = ((struct sockaddr_in *)&req.ifr_addr)->sin_addr.s_addr;
+			if (ioctl(sockfd, SIOCGIFFLAGS, &req) != 0) continue;
+			if (req.ifr_flags & (IFF_LOOPBACK | IFF_POINTOPOINT)) continue;
+			if ((req.ifr_flags & IFF_UP) == 0) continue;
+			if (ioctl(sockfd, SIOCGIFNETMASK, &req) != 0) continue;
+			subnets.emplace_back(ip, ((struct sockaddr_in *)&req.ifr_netmask)->sin_addr.s_addr);
+		}
+	}
+	close(sockfd);
+	return subnets;
+}
+
+std::vector<unsigned long> NetSocketAddr()
+{
+	std::vector<unsigned long> ips;
+	for (const auto &subnet : NetSocketSubnets()) {
+		ips.push_back(subnet.first);
+	}
+	return ips;
+}
